# ---------------------------------------------------------------------------
# HypotheekCheck NL — omgevingsvariabelen
# Kopieer naar .env.local (lokaal) en vul in. Zet dezelfde waarden in Vercel.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (Vercel Marketplace-integratie vult dit automatisch in)
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clerk (dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob (Vercel Marketplace / Storage-integratie vult dit automatisch in)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Model voor documentextractie, chat en adviesteksten
ANTHROPIC_MODEL=claude-sonnet-5
# Optioneel ander model voor het eindrapport (bijv. claude-opus-5-5)
ANTHROPIC_MODEL_REPORT=claude-sonnet-5

# Versleuteling op applicatieniveau (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Beveiliging van cron-endpoints (Vercel stuurt dit mee als Bearer-token). Min. 16 tekens:
#   openssl rand -hex 32
CRON_SECRET=

# Bewaartermijn voor documenten in dagen (standaard 90)
DOCUMENT_RETENTION_DAYS=90

# Maximaal aantal AI-verzoeken per gebruiker per uur
AI_RATE_LIMIT_PER_HOUR=30

# Content-Security-Policy: extra hosts (spatie-gescheiden), bijv. je Clerk-productiedomein:
# CSP_EXTRA_HOSTS=https://clerk.jouwdomein.nl https://accounts.jouwdomein.nl

# Lokaal zonder Neon: ingebedde Postgres (alleen ontwikkeling, nooit op Vercel)
# DATABASE_URL=pglite:./.pglite

# Alleen lokaal voor e2e-tests: auth via testcookie. NOOIT in productie zetten.
# E2E_TEST_MODE=1
